{
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "runnables": [
          {
            "script": {
              "text": "set -e\nexport BUCKET=BUCKETURI\nexport PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\nmkdir -p /var/tmp/boot\ncd /var/tmp/boot\ngcloud storage cp BUCKETURI/src/eval-COMMIT.tar .\ntar xf eval-COMMIT.tar '0028/gcpbuild.sh'\nbash '0028/gcpbuild.sh' COMMIT FNCT NAME EXTRA\n"
            }
          }
        ],
        "computeResource": {
          "cpuMilli": 286000,
          "memoryMib": 2200000
        },
        "maxRunDuration": "14400s",
        "maxRetryCount": 0
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "c4-highmem-288-lssd",
          "provisioningModel": "STANDARD",
          "bootDisk": {
            "type": "hyperdisk-balanced",
            "sizeGb": "100"
          }
        }
      }
    ],
    "location": {
      "allowedLocations": [
        "regions/us-central1"
      ]
    }
  },
  "labels": {
    "purpose": "build",
    "machine": "c4"
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
